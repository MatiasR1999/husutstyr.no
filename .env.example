# Explicit LOCAL QA only. Never enable on Vercel or a public server.
SEO_QA_MODE=false
NETWORK_LINKS_ENABLED=false
# Phase 2: provide the independent site's Neon connection through secret storage.
DATABASE_URL=
# Must use seo_public_reader; never put the migration owner's URL in runtime.
# Must equal the completed site.config.ts identity URL in production.
SITE_URL=https://husutstyr.no
# Restricted service role: seo_editor_service.
EDITOR_DATABASE_URL=
# Google Cloud web application credentials; register /api/auth/callback.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Only a loopback QA run may enable the separate signed test issuer.
OIDC_TEST_MODE=false
# Phase 3: bearer credential for the private durable-job worker, minimum 32 characters.
PUBLICATION_WORKER_SECRET=
# Domain verification key for the configured IndexNow endpoint, 8-128 allowed characters.
INDEXNOW_KEY=
